{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS", // Esto es vital para que Node lo entienda bien
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true, // Permite importar librerías de JS antiguo
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}